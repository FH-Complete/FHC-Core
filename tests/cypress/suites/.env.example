# Keys of the noten suite. Copy to tests/cypress/suites/.env (not in Git) and fill in the passwords.
# This file IS in Git: never put a real password here. A value from the environment wins over the file.
# WARNING: the suite deletes and writes grades. Use a test database only.
# The default values are the test data of seeder TST60873 (npm run noten:check -- seed).

# ---- required: the Lektor the suite works as ---------------------------------------------------
NOTEN_LEKTOR_USER=demolektor1
NOTEN_LEKTOR_PASSWORD=

# ---- required: the database of the instance at BASE_URL ----------------------------------------
# The suite resets its test data directly in the database. Without it every spec fails.
NOTEN_DB_HOST=
NOTEN_DB_PORT=5432
NOTEN_DB_NAME=
NOTEN_DB_USER=
NOTEN_DB_PASSWORD=
NOTEN_DB_SSL=false
NOTEN_DB_ALLOW_WRITES=true

# ---- optional: empty -> the tests that need the value skip -------------------------------------

# The test LV. Empty -> the first LV of NOTEN_LEKTOR_USER. Empty semester -> the current one.
NOTEN_LV_ID=5221
NOTEN_SEM_KURZBZ=

# Role tests: an account with only the permission lehre/benotungstool_assistenz.
NOTEN_ASSISTENZ_USER=demoassistenz
NOTEN_ASSISTENZ_PASSWORD=

# Freigabe tests: the LDAP password of NOTEN_LEKTOR_USER. Empty -> NOTEN_LEKTOR_PASSWORD.
# A Freigabe sends a mail. Use an instance that sends all mail to a debug mailbox (MAIL_DEBUG).
NOTEN_FREIGABE_PASSWORD=
