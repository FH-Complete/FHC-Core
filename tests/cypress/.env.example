# Copy to tests/cypress/.env (not in Git) and fill in.
# Only the keys that all suites share. A suite keeps its own keys in the .env next to its suite file:
# tests/cypress/suites/.env for a suite of core, <folder>/.env for the tests/cypress folder of an extension.

# The instance under test. There is no default: an empty value stops the run.
BASE_URL=

# The default account of cy.login, cy.fhcGet and cy.fhcPost: Cypress.env("adminusername") / ("adminpassword").
USER_NAME=
USER_PASSWORD=

# The database of the instance at BASE_URL. The suites reset their test data directly in it.
# WARNING: the suites delete and write data. Use a test database only.
TEST_DB_HOST=
TEST_DB_PORT=5432
TEST_DB_NAME=
TEST_DB_USER=
TEST_DB_PASSWORD=
TEST_DB_SSL=false
TEST_DB_ALLOW_WRITES=true
