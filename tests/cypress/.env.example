# Copy to tests/cypress/.env (not in Git) and fill in.
# Only the keys that all suites share. The noten suite keeps its keys in tests/cypress/suites/.env.

# The instance under test. There is no default: an empty value stops the run.
BASE_URL=

# A login for Cypress.env("adminusername") / ("adminpassword"). The noten suite does not use it.
USER_NAME=
USER_PASSWORD=
