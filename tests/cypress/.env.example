# Copy to tests/cypress/.env (gitignored) and fill in.
# THIS FILE IS COMMITTED - never put a real password in it.

# ---- required -------------------------------------------------------------------------------

# Your own instance, e.g. https://c3p0.dev.technikum-wien.at/<kuerzel>/fhcompletecis4
# No default anywhere: empty fails the run rather than pointing it at a colleague's installation.
BASE_URL=

# HTTP Basic + LDAP user the API calls authenticate as. Use the LECTURER under test
# (e.g. demolektor1) - getBenotungstoolContext resolves that user's own Lehrveranstaltungen,
# and an admin account usually teaches nothing and would resolve none.
USER_NAME=
USER_PASSWORD=

# ---- required: fixture reset ------------------------------------------------------------------
# The suite resets its fixture over a direct database connection; there is no HTTP fallback, so
# the specs fail without it. TEST_ENV_PREFIX selects the <PREFIX>_DB_* / <PREFIX>_SSH_* names.
TEST_ENV_PREFIX=NOTEN

NOTEN_DB_HOST=db.dev.technikum-wien.at
NOTEN_DB_PORT=5432
NOTEN_DB_NAME=
NOTEN_DB_USER=
NOTEN_DB_PASSWORD=
NOTEN_DB_ALLOW_WRITES=true

# ---- required from a workstation: SSH tunnel --------------------------------------------------
# pg_hba.conf admits only the application server. NOTEN_DB_HOST above stays the REAL database -
# the tunnel rewrites the connection to 127.0.0.1 itself.
#
# Two things that are easy to get wrong:
#  - the SSH host is usually NOT the web hostname
#  - a key whose filename is not an OpenSSH default is NEVER tried automatically; name it here,
#    or leave NOTEN_SSH_KEY empty to use your SSH agent
NOTEN_SSH_TUNNEL=true
NOTEN_SSH_HOST=
NOTEN_SSH_USER=
NOTEN_SSH_KEY=

# ---- optional ---------------------------------------------------------------------------------

# Semester and LV are discovered at runtime. Pin them only when discovery picks the wrong one.
NOTEN_SEM=
NOTEN_LV_ID=

# Access-control specs: this API has no impersonation, so scoping needs a second real login.
# NOTEN_FOREIGN_LV_ID must be an LV this teacher does NOT teach. Unset -> those specs skip.
NOTEN_TEACHER_USER=
NOTEN_TEACHER_PASSWORD=
NOTEN_FOREIGN_LV_ID=

# Configuration profiles (tests/cypress/profiles/noten.js) change application/config/noten.php and the
# define() flags in config/global.config.inc.php on the instance, over SSH, and restore them after the
# run. NOTEN_REMOTE_ROOT is the absolute path of the instance on its host.
#   npm run cy:noten:profile            every profile, then a report
#   npm run noten:profil -- status      the active profile
NOTEN_REMOTE_ROOT=
# Only if the instance runs on another host than the SSH tunnel above. With NOTEN_PROFIL_SSH_HOST set,
# every profile SSH value comes from NOTEN_PROFIL_SSH_*; an empty key uses the SSH agent (on Windows
# the OpenSSH agent service). Without it the profiles use NOTEN_SSH_*.
NOTEN_PROFIL_SSH_HOST=
NOTEN_PROFIL_SSH_USER=
NOTEN_PROFIL_SSH_KEY=
# Only for a test instance with a self-signed certificate: the Node side (profile check, lock test)
# rejects it otherwise. Never set this for anything else.
# NODE_TLS_REJECT_UNAUTHORIZED=0
# a profile for every plain run; empty = the instance as deployed
NOTEN_PROFIL=

# LDAP password of USER_NAME for the Freigabe specs. Empty -> USER_PASSWORD.
# A successful Freigabe sends the Notenfreigabe mail. Run the suite only on an instance whose mail goes to a
# debug mailbox (MAIL_DEBUG), as on the dev machines.
NOTEN_FREIGABE_PASSWORD=
