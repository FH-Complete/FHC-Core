# Copy to tests/cypress/.env (gitignored) and fill in.
# Only the keys every suite shares. A suite keeps its own keys in tests/cypress/suites/.env.

# The instance under test. No default anywhere: empty fails the run rather than pointing it at a colleague's installation.
BASE_URL=

# HTTP Basic + LDAP user for Cypress.env("adminusername") / ("adminpassword").
USER_NAME=
USER_PASSWORD=
