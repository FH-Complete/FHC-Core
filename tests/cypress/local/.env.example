# Local workstation: SSH tunnel to the database and configuration profiles via SFTP.
# Copy to tests/cypress/local/.env. The suite itself never reads this file.

# ---- SSH tunnel (withTunnel.js) --------------------- ---------------------------------------------
# pg_hba.conf only allows the application server. NOTEN_DB_HOST in suites/.env remains the ACTUAL database.
#  - The SSH host is usually NOT the web hostname
#  - A key outside the OpenSSH default names is never automatically tried; specify it here,
#    or leave NOTEN_SSH_KEY empty for the SSH agent
NOTEN_SSH_HOST=
NOTEN_SSH_PORT=22
NOTEN_SSH_USER=
NOTEN_SSH_KEY=
NOTEN_SSH_PASSPHRASE=

# ---- Configuration profiles (notenProfiles.js) ------------------------------------------------ ---
# Absolute path of the instance on its host.
NOTEN_REMOTE_ROOT=
# Only if the instance is on a different host than the tunnel. With NOTEN_PROFILE_SSH_HOST, every
# SSH value in the profiles comes from NOTEN_PROFILE_SSH_*; an empty key uses the SSH agent.
NOTEN_PROFILE_SSH_HOST=
NOTEN_PROFILE_SSH_USER=
NOTEN_PROFILE_SSH_KEY=

# Only for an instance with a self-signed certificate: otherwise, the Node side will reject it.
# NODE_TLS_REJECT_UNAUTHORIZED=0
