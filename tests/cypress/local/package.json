{
  "private": true,
  "description": "Eigener Arbeitsplatz: Lint und Format.",
  "scripts": {
    "lint": "cd .. && eslint -c local/eslint.config.js cypress.config.js suites tasks tools local support e2e/specs/api/noten e2e/specs/ui/noten",
    "format": "cd .. && prettier --config local/package.json --write cypress.config.js \"{suites,tasks,tools,local,support}/**/*.js\" \"e2e/specs/{api,ui}/noten/**/*.js\""
  },
  "prettier": {
    "useTabs": true,
    "tabWidth": 4,
    "printWidth": 120,
    "endOfLine": "auto"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.2",
    "globals": "^17.12.0",
    "prettier": "^3.9.7"
  }
}
